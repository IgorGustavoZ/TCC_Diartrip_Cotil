,4.99-2.06,1.44-1.44,2.12-3.12,2.12-5.06s-.69-3.68-2.12-5.06c-1.37-1.44-3.06-2.12-4.99-2.12h-39.95v14.3h39.95Z"/>
                        </Canvas>
                    </Grid>
                </Viewbox>

                <TextBlock Text="Painel Administrativo"
                           FontSize="20"
                           Foreground="#CBD5E1"/>

                <TextBlock Text="Gerencie relatórios, usuários e estatísticas da plataforma."
                           FontSize="15"
                           Margin="0,26,0,0"
                           MaxWidth="380"
                           LineHeight="22"
                           TextWrapping="Wrap"
                           Foreground="{StaticResource TextMutedBrush}"/>

            </StackPanel>

        </Border>

        <!-- ============ LADO DIREITO ============ -->
        <Grid Grid.Column="1" Background="#0F172A">

            <Border
                Width="360"
                Padding="36"
                Background="{StaticResource CardBrush}"
                BorderBrush="{StaticResource BorderBrush1}"
                BorderThickness="1"
                CornerRadius="20"
                Effect="{StaticResource CardShadow}"
                VerticalAlignment="Center"
                HorizontalAlignment="Center">

                <StackPanel>

                    <TextBlock
                        Text="Login"
                        FontSize="30"
                        FontWeight="Bold"
                        Foreground="{StaticResource TextPrimaryBrush}"
                        HorizontalAlignment="Center"/>

                    <TextBlock
                        Text="Entre com sua conta Admin"
                        Foreground="{StaticResource TextMutedBrush}"
                        FontSize="14"
                        Margin="0,8,0,28"
                        HorizontalAlignment="Center"/>

                    <!-- EMAIL -->
                    <TextBlock
                        Text="Email"
                        FontSize="13"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource TextMutedBrush}"
                        Margin="2,0,0,8"/>

                    <TextBox
                        x:Name="txtEmail"
                        Style="{StaticResource FieldTextBoxStyle}"
                        Margin="0,0,0,18"/>

                    <!-- SENHA -->
                    <TextBlock
                        Text="Senha"
                        FontSize="13"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource TextMutedBrush}"
                        Margin="2,0,0,8"/>

                    <PasswordBox
                        x:Name="txtSenha"
                        Style="{StaticResource FieldPasswordBoxStyle}"
                        Margin="0,0,0,28"/>

                    <!-- BOTÃO -->
                    <Button
                        x:Name="btnEntrar"
                        Content="Entrar"
                        Height="46"
                        FontSize="16"
                        FontWeight="SemiBold"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Click="btnEntrar_Click"/>

                    <!-- ERRO -->
                    <TextBlock
                        x:Name="txtErro"
                        Foreground="#F87171"
                        FontSize="13"
                        Margin="0,18,0,0"
                        TextWrapping="Wrap"
                        TextAlignment="Center"
                        Visibility="Collapsed"/>

                </StackPanel>

            </Border>

        </Grid>

    </Grid>

</Window>
