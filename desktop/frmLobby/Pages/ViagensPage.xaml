<Page x:Class="WindowLobby.Pages.ViagensPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="clr-namespace:WindowLobby.Pages">

    <Page.Resources>

        <local:DataYyyyMmDdConverter x:Key="DataYyyyMmDdConverter"/>

        <SolidColorBrush x:Key="CardBrush" Color="#1E293B"/>
        <SolidColorBrush x:Key="FieldBrush" Color="#0F172A"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#3B82F6"/>
        <SolidColorBrush x:Key="AccentBrushHover" Color="#2563EB"/>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F8FAFC"/>
        <SolidColorBrush x:Key="TextMutedBrush" Color="#94A3B8"/>
        <SolidColorBrush x:Key="BorderBrush2" Color="#27324A"/>

        <!-- Labels -->
        <Style x:Key="FilterLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="2,0,0,6"/>
        </Style>

        <!-- Textbox filter style -->
        <Style x:Key="FilterTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource FieldBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush2}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="CaretBrush" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="SelectionBrush" Value="{StaticResource AccentBrush}"/>
            <Setter Property="SelectionTextBrush" Value="White"/>
            <Setter Property="Margin" Value="0,0,0,18"/>
        </Style>

        <!-- O selecionador de datas -->
        <Style TargetType="{x:Type DatePickerTextBox}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type DatePickerTextBox}">
                        <TextBox x:Name="PART_TextBox"
                                 Text="{Binding Path=SelectedDate,
                                                RelativeSource={RelativeSource AncestorType={x:Type DatePicker}},
                                                StringFormat=yyyy/MM/dd,
                                                Mode=OneWay}"
                                 Background="Transparent"
                                 Foreground="{StaticResource TextPrimaryBrush}"
                                 CaretBrush="{StaticResource TextPrimaryBrush}"
                                 SelectionBrush="{StaticResource AccentBrush}"
                                 BorderThickness="0"
                                 Padding="0"
                                 VerticalAlignment="Center"
                                 IsReadOnly="True"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- DatePicker filter style -->
        <Style x:Key="FilterDatePickerStyle" TargetType="DatePicker">
            <Setter Property="Background" Value="{StaticResource FieldBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush2}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Margin" Value="0,0,0,18"/>
        </Style>

        <!-- Apply filters button -->
        <Style x:Key="FilterButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource AccentBrushHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Clear filters button -->
        <Style x:Key="ClearButtonStyle" TargetType="Button" BasedOn="{StaticResource FilterButtonStyle}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{StaticResource BorderBrush2}"
                                BorderThickness="1"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#243248"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ListView header style -->
        <Style x:Key="ListHeaderStyle" TargetType="{x:Type GridViewColumnHeader}">
            <Setter Property="Background" Value="#243248"/>
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush2}"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- ListView row style -->
        <Style x:Key="ListRowStyle" TargetType="{x:Type ListViewItem}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="#1A2438"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListViewItem}">
                        <Border x:Name="border"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        Padding="{TemplateBinding Padding}">
                            <GridViewRowPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1A2438"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1D3A63"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Page.Resources>

    <Grid Background="Transparent">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ============ Filtros ============ -->

        <Border Grid.Column="0"
                Background="{StaticResource CardBrush}"
                BorderBrush="{StaticResource BorderBrush2}"
                BorderThickness="0,0,1,0"
                Padding="18,20"
                Margin="0,0,16,0"
                CornerRadius="12">

            <StackPanel>

                <TextBlock Text="Filtros"
                           FontSize="18"
                           FontWeight="Bold"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           Margin="0,0,0,20"/>

                <TextBlock Text="ID" Style="{StaticResource FilterLabelStyle}"/>
                <TextBox x:Name="txtFiltroId" Style="{StaticResource FilterTextBoxStyle}"/>

                <TextBlock Text="NOME" Style="{StaticResource FilterLabelStyle}"/>
                <TextBox x:Name="txtFiltroNome" Style="{StaticResource FilterTextBoxStyle}"/>

                <TextBlock Text="DESTINO PRINCIPAL" Style="{StaticResource FilterLabelStyle}"/>
                <TextBox x:Name="txtFiltroDestino" Style="{StaticResource FilterTextBoxStyle}"/>

                <TextBlock Text="DATA DE INÍCIO" Style="{StaticResource FilterLabelStyle}"/>
                <DatePicker x:Name="dpFiltroDataInicio" Style="{StaticResource FilterDatePickerStyle}"/>

                <TextBlock Text="DATA DE FIM" Style="{StaticResource FilterLabelStyle}"/>
                <DatePicker x:Name="dpFiltroDataFim" Style="{StaticResource FilterDatePickerStyle}"/>

                <TextBlock Text="CRIADO POR" Style="{StaticResource FilterLabelStyle}"/>
                <TextBox x:Name="txtFiltroCriadoPor" Style="{StaticResource FilterTextBoxStyle}"/>

                <Button x:Name="BtnFiltrar" Content="Filtrar"
                        Style="{StaticResource FilterButtonStyle}"
                        Margin="0,8,0,10"
                        Click="BtnFiltrar_Click"/>

                <Button x:Name="BtnLimparFiltros" Content="Limpar filtros"
                        Style="{StaticResource ClearButtonStyle}"
                        Click="BtnLimparFiltros_Click"/>

            </StackPanel>

        </Border>

        <!-- ============ Listars ============ -->

        <Grid Grid.Column="1">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
               Text="Viagens"
               FontSize="24"
               FontWeight="Bold"
               Foreground="{StaticResource TextPrimaryBrush}"
               Margin="0,0,0,16"/>

            <Border Grid.Row="1"
            Background="{StaticResource CardBrush}"
            BorderBrush="{StaticResource BorderBrush2}"
            BorderThickness="1"
            CornerRadius="12">

                <ListView x:Name="listViagens"
                  Background="Transparent"
                  Foreground="{StaticResource TextPrimaryBrush}"
                  BorderThickness="0"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch"
                  HorizontalContentAlignment="Stretch"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                  ItemContainerStyle="{StaticResource ListRowStyle}"
                  GridViewColumnHeader.Click="ListViewHeader_Click"
                  MouseDoubleClick="ListViagens_MouseDoubleClick">

                    <ListView.View>
                        <GridView ColumnHeaderContainerStyle="{StaticResource ListHeaderStyle}">

                            <GridViewColumn Header="Id"
                                    DisplayMemberBinding="{Binding id_grupo}"
                                    Width="80"/>

                            <GridViewColumn Header="Nome"
                                    DisplayMemberBinding="{Binding nome_grupo}"
                                    Width="200"/>

                            <GridViewColumn Header="Destino Principal"
                                    DisplayMemberBinding="{Binding destino_principal}"
                                    Width="200"/>

                            <GridViewColumn Header="Data de Início" Width="120">
                                <GridViewColumn.DisplayMemberBinding>
                                    <Binding Path="data_inicio" Converter="{StaticResource DataYyyyMmDdConverter}"/>
                                </GridViewColumn.DisplayMemberBinding>
                            </GridViewColumn>

                            <GridViewColumn Header="Data de Fim" Width="120">
                                <GridViewColumn.DisplayMemberBinding>
                                    <Binding Path="data_fim" Converter="{StaticResource DataYyyyMmDdConverter}"/>
                                </GridViewColumn.DisplayMemberBinding>
                            </GridViewColumn>

                            <GridViewColumn Header="Criado por"
                                    DisplayMemberBinding="{Binding criador}"
                                    Width="160"/>

                        </GridView>
                    </ListView.View>

                </ListView>

            </Border>

        </Grid>

    </Grid>

</Page>
