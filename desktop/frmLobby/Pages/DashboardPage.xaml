<Page x:Class="WindowLobby.Pages.DashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WindowLobby.Pages"
      xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Background="Transparent"
      Title="DashboardPage">

    <Page.Resources>

        <SolidColorBrush x:Key="CardBrush" Color="#1E293B"/>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F8FAFC"/>
        <SolidColorBrush x:Key="TextMutedBrush" Color="#94A3B8"/>
        <SolidColorBrush x:Key="BorderBrush2" Color="#27324A"/>

        <DropShadowEffect x:Key="CardShadow" BlurRadius="18" ShadowDepth="2"
                           Direction="270" Color="#000000" Opacity="0.35"/>

        <Style x:Key="StatCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBrush}"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Margin" Value="10"/>
            <Setter Property="Effect" Value="{StaticResource CardShadow}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#27324A"/>
        </Style>

        <Style x:Key="ChartCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush2}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Margin" Value="10"/>
            <Setter Property="Padding" Value="22,20"/>
            <Setter Property="Effect" Value="{StaticResource CardShadow}"/>
        </Style>

        <Style x:Key="ChartTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>

    </Page.Resources>

    <Grid Margin="-10,0,-10,0">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="10,0,10,20">
            <TextBlock Text="Dashboard"
                       FontSize="28"
                       FontWeight="Bold"
                       Foreground="{StaticResource TextPrimaryBrush}"/>
            <TextBlock Text="Painel administrativo"
                       Foreground="{StaticResource TextMutedBrush}"
                       FontSize="15"
                       Margin="0,4,0,0"/>
        </StackPanel>

        <UniformGrid Grid.Row="1" Columns="3">

            <Border Style="{StaticResource StatCardStyle}">
                <Grid Margin="22,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="VIAGENS" Foreground="{StaticResource TextMutedBrush}"
                                   FontSize="12" FontWeight="SemiBold"/>
                        <TextBlock x:Name="txtViagens" Text="0"
                                   FontSize="36" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   Margin="0,6,0,0"/>
                    </StackPanel>
                    <Border Grid.Column="1" Width="44" Height="44" CornerRadius="12"
                            Background="#1D3A63" VerticalAlignment="Top">
                        <TextBlock Text="✈" FontSize="18" Foreground="#60A5FA"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>

            <Border Style="{StaticResource StatCardStyle}">
                <Grid Margin="22,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="USUÁRIOS" Foreground="{StaticResource TextMutedBrush}"
                                   FontSize="12" FontWeight="SemiBold"/>
                        <TextBlock x:Name="txtUsuarios" Text="0"
                                   FontSize="36" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   Margin="0,6,0,0"/>
                    </StackPanel>
                    <Border Grid.Column="1" Width="44" Height="44" CornerRadius="12"
                            Background="#1D3A2E" VerticalAlignment="Top">
                        <TextBlock Text="👥" FontSize="18" Foreground="#4ADE80"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>

            <Border Style="{StaticResource StatCardStyle}">
                <Grid Margin="22,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="TOKENS USADOS PELA IA" Foreground="{StaticResource TextMutedBrush}"
                                   FontSize="12" FontWeight="SemiBold"/>
                        <TextBlock x:Name="txtChatIA" Text="0"
                                   FontSize="36" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   Margin="0,6,0,0"/>
                    </StackPanel>
                    <Border Grid.Column="1" Width="44" Height="44" CornerRadius="12"
                            Background="#3A2A1D" VerticalAlignment="Top">
                        <TextBlock Text="💬" FontSize="18" Foreground="#FBBF24"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>

        </UniformGrid>

        <!-- ============ Cartelinhas ============ -->

        <Grid Grid.Row="2">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Usuários novos por mês (últimos 12 meses) -->
            <Border Grid.Column="0" Style="{StaticResource ChartCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="Novos usuários por mês (últimos 12 meses)"
                               Style="{StaticResource ChartTitleStyle}"/>

                    <lvc:CartesianChart x:Name="chartUsuarios"
                                        Grid.Row="1"
                                        Background="Transparent"
                                        LegendPosition="Hidden"
                                        ZoomMode="None"/>

                </Grid>
            </Border>

            <!-- TOP destinos das viagens -->
            <Border Grid.Column="1" Style="{StaticResource ChartCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="Top destinos das viagens"
                               Style="{StaticResource ChartTitleStyle}"/>

                    <lvc:PieChart x:Name="chartDestinos"
                                  Grid.Row="1"
                                  Background="Transparent"
                                  LegendPosition="Right"/>

                </Grid>
            </Border>

        </Grid>

    </Grid>

</Page>
