<Window x:Class="WindowLobby.Dashboard"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dashboard"
        WindowState="Maximized"
        Background="#0F172A"
        Height="1011" Width="1499"
        FontFamily="Segoe UI">

    <Window.Resources>

        <!-- Paleta de cores -->
        <SolidColorBrush x:Key="BgBrush" Color="#0F172A"/>
        <SolidColorBrush x:Key="SidebarBrush" Color="#111827"/>
        <SolidColorBrush x:Key="CardBrush" Color="#1E293B"/>
        <SolidColorBrush x:Key="CardBrushHover" Color="#243248"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#3B82F6"/>
        <SolidColorBrush x:Key="AccentBrushHover" Color="#2563EB"/>
        <SolidColorBrush x:Key="DangerBrush" Color="#7F1D1D"/>
        <SolidColorBrush x:Key="DangerBrushHover" Color="#991B1B"/>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F8FAFC"/>
        <SolidColorBrush x:Key="TextMutedBrush" Color="#94A3B8"/>

        <!-- Drop shadow -->
        <DropShadowEffect x:Key="CardShadow" BlurRadius="18" ShadowDepth="2"
                           Direction="270" Color="#000000" Opacity="0.35"/>

        <!-- Sidebar navigação button style -->
        <Style x:Key="NavButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="52"/>
            <Setter Property="Margin" Value="0,6,0,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10"
                                Padding="16,0">
                            <ContentPresenter VerticalAlignment="Center"
                                               HorizontalAlignment="Left"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1E293B"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Logout button styl -->
        <Style x:Key="LogoutButtonStyle" TargetType="Button" BasedOn="{StaticResource NavButtonStyle}">
            <Setter Property="Foreground" Value="#FCA5A5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="#2A1414"
                                CornerRadius="10"
                                Padding="16,0">
                            <ContentPresenter VerticalAlignment="Center"
                                               HorizontalAlignment="Left"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource DangerBrushHover}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Small weak vulnerable logout button -->
        <Style x:Key="LogoutButtonSmallStyle" TargetType="Button">
            <Setter Property="Background" Value="#2A1414"/>
            <Setter Property="Foreground" Value="#FCA5A5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10">
                            <ContentPresenter VerticalAlignment="Center"
                                               HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource DangerBrushHover}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Ele adora exportar pdfs -->
        <Style x:Key="AccentButtonStyle" TargetType="Button" BasedOn="{StaticResource NavButtonStyle}">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{StaticResource AccentBrush}"
                                CornerRadius="10"
                                Padding="16,0">
                            <ContentPresenter VerticalAlignment="Center"
                                               HorizontalAlignment="Left"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource AccentBrushHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        

    </Window.Resources>

    <Grid Background="{StaticResource BgBrush}">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ============ BARRALATERAL ============ -->

        <Border Grid.Column="0" Background="{StaticResource SidebarBrush}">

            <DockPanel Margin="18,24,18,24">

                <!-- Menu (top) -->
                <StackPanel DockPanel.Dock="Top">

                    <StackPanel Orientation="Horizontal" Margin="6,0,0,44">
                        <Border Width="34" Height="34" CornerRadius="10" Background="{StaticResource AccentBrush}">
                            <TextBlock Text="✈" FontSize="16" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="DiarTrip"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   VerticalAlignment="Center"
                                   Margin="10,0,0,0"/>
                    </StackPanel>

                    <TextBlock Text="MENU" FontSize="11" FontWeight="SemiBold"
                               Foreground="#475569" Margin="16,0,0,10"/>

                    <Button Content="🏠   Dashboard"
                            Style="{StaticResource NavButtonStyle}"
                            Click="BtnDashboard_Click"/>

                    <Button Content="👥   Usuários"
                            Style="{StaticResource NavButtonStyle}"
                            Click="BtnUsuarios_Click"/>

                    <Button Content="✈   Viagens"
                            Style="{StaticResource NavButtonStyle}"
                            Click="BtnViagens_Click"/>

                    <Button Content="✨   Conversas IA"
                            Style="{StaticResource NavButtonStyle}"
                            Click="BtnChatIA_Click"/>

                    <Button Content="📌    Posts"
                            Style="{StaticResource NavButtonStyle}"
                            Click="BtnPost_Click"/>

                    <Button Content="⚙   Configurações"
                            Style="{StaticResource NavButtonStyle}"
                            Click="BtnConfiguracoes_Click"/>

                    <Button x:Name="BtnExpPdf" Content="📄   Exportar PDF"
                            Style="{StaticResource AccentButtonStyle}"
                            Margin="0,20,0,0"
                            Click="BtnExpPdf_Click"/>

                </StackPanel>

                <!-- proliferar e logout -->
                <Grid DockPanel.Dock="Bottom">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Height="52"
                            CornerRadius="14"
                            Background="#1E293B"
                            BorderBrush="#27324A"
                            BorderThickness="1"
                            Padding="10,0"
                            Margin="0,0,8,0" VerticalAlignment="Bottom">

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                            <Border Width="32" Height="32"
                                    CornerRadius="16"
                                    BorderBrush="{StaticResource AccentBrush}"
                                    BorderThickness="2">
                                <Border CornerRadius="14" ClipToBounds="True">
                                    <Image x:Name="imgPerfil" Stretch="UniformToFill"/>
                                </Border>
                            </Border>

                            <TextBlock Name="txtUsuario"
                                       Text="Admin"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       FontWeight="SemiBold"
                                       FontSize="13"
                                       Margin="10,0,2,0"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"/>

                        </StackPanel>

                    </Border>

                    <Button Grid.Column="1"
                            Content="🚪"
                            Style="{StaticResource LogoutButtonSmallStyle}"
                            Width="52" Height="52"
                            ToolTip="Sair"
                            Click="BtnLogout_Click" VerticalAlignment="Bottom"/>

                </Grid>

            </DockPanel>

        </Border>

        <!-- ============ Mainframe ============ -->

        <Grid Grid.Column="1" Margin="36,32,36,32">

            <Frame x:Name="MainFrame"
                   NavigationUIVisibility="Hidden"
                   Navigated="MainFrame_Navigated"
                   HorizontalAlignment="Stretch"
                   VerticalAlignment="Stretch" Background="#FF1E293B" BorderBrush="Red" Margin="0,0,-3,0" Padding="15,15,15,15"/>

        </Grid>

    </Grid>

</Window>
