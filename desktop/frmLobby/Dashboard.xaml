                                    <Path.RenderTransform>
                                        <TransformGroup>
                                            <ScaleTransform/>
                                            <SkewTransform/>
                                            <RotateTransform Angle="0.076"/>
                                            <TranslateTransform/>
                                        </TransformGroup>
                                    </Path.RenderTransform>
                                </Path>
                            </Canvas>
                        </Grid>
                    </StackPanel>

                    <TextBlock Text="MENU" FontSize="11" FontWeight="SemiBold"
                               Foreground="#475569" Margin="16,0,0,10"/>

                    <Button Content="🏠   Dashboard"
                            Style="{StaticResource NavButtonStyle}"
                            Click="BtnDashboard_Click"/>

                    <Button Content="👥   Usuários"
                            Style="{StaticResource NavButtonStyle}"
                            Click="BtnUsuarios_Click"/>

                    <Button Content="✈   Viagens"
                            Style="{StaticResource NavButtonStyle}"
                            Click="BtnViagens_Click"/>

                    <Button Content="✨   Conversas IA"
                            Style="{StaticResource NavButtonStyle}"
                            Click="BtnChatIA_Click"/>

                    <Button Content="📌    Posts"
                            Style="{StaticResource NavButtonStyle}"
                            Click="BtnPost_Click"/>

                    <Button Content="⚙   Configurações"
                            Style="{StaticResource NavButtonStyle}"
                            Click="BtnConfiguracoes_Click"/>

                    <Button x:Name="BtnExpPdf" Content="📄   Exportar PDF"
                            Style="{StaticResource AccentButtonStyle}"
                            Margin="0,20,0,0"
                            Click="BtnExpPdf_Click"/>

                </StackPanel>

                <!-- proliferar e logout -->
                <Grid DockPanel.Dock="Bottom">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Height="52"
                            CornerRadius="14"
                            Background="#1E293B"
                            BorderBrush="#27324A"
                            BorderThickness="1"
                            Padding="10,0"
                            Margin="0,0,8,0" VerticalAlignment="Bottom">

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                            <Border Width="32" Height="32"
                            CornerRadius="16"
                            BorderBrush="{StaticResource AccentBrush}"
                            BorderThickness="2">
                                <Ellipse>
                                    <Ellipse.Fill>
                                        <!-- Adicionamos o x:Name aqui para acessar no C# -->
                                        <ImageBrush x:Name="imgPerfilBrush" Stretch="UniformToFill"/>
                                    </Ellipse.Fill>
                                </Ellipse>
                            </Border>

                            <TextBlock Name="txtUsuario"
                                       Text="Admin"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       FontWeight="SemiBold"
                                       FontSize="13"
                                       Margin="10,0,2,0"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"/>

                        </StackPanel>

                    </Border>

                    <Button Grid.Column="1"
                            Content="🚪"
                            Style="{StaticResource LogoutButtonSmallStyle}"
                            Width="52" Height="52"
                            ToolTip="Sair"
                            Click="BtnLogout_Click" VerticalAlignment="Bottom"/>

                </Grid>

            </DockPanel>

        </Border>

        <!-- ============ Mainframe ============ -->

        <Grid Grid.Column="1" Margin="36,32,36,32">

            <Frame x:Name="MainFrame"
                   NavigationUIVisibility="Hidden"
                   Navigated="MainFrame_Navigated"
                   HorizontalAlignment="Stretch"
                   VerticalAlignment="Stretch" Background="#FF1E293B" BorderBrush="Red" Margin="0,0,-3,0" Padding="15,15,15,15"/>

        </Grid>

    </Grid>

</Window>
