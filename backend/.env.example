# ──────────────────────────────────────────────────────────────────────────────
# Diartrip — Variáveis de Ambiente
# Copie este arquivo para .env e preencha os valores antes de iniciar.
# NUNCA comite o arquivo .env com credenciais reais.
# ──────────────────────────────────────────────────────────────────────────────

# ── Banco de Dados MySQL ──────────────────────────────────────────────────────
# Em Docker: DB_HOST deve ser o nome do serviço definido no docker-compose.yml ("db")
# Em desenvolvimento local fora do Docker: use "localhost"
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# Pool de conexões MySQL (por worker do uvicorn)
DB_POOL_SIZE=5

# Retry de conexão MySQL no startup: max tentativas e espera base em segundos
# O backoff é exponencial: espera = min(base * 2^(tentativa-1), 30s)
DB_RETRY_MAX=15
DB_RETRY_BASE_WAIT=1.0

# ── Autenticação JWT ──────────────────────────────────────────────────────────
# Gere uma chave segura: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
ALGORITHM=HS256

# ── Redis — blacklist de tokens e rate limiting ───────────────────────────────
# Em Docker: use o nome do serviço ("redis")
# Em desenvolvimento local: use "redis://localhost:6379/0"
# Deixe vazio para usar fallback em memória (não recomendado em produção)
REDIS_URL=redis://redis:6379/0

# ── Integração com IA (OpenRouter) ───────────────────────────────────────────
# Crie conta grátis em https://openrouter.ai e copie sua API key
OPENROUTER_API_KEY=
IA_MODEL=google/gemini-3-flash-preview

# ── Geoapify — geocodificação e pontos de interesse reais ────────────────────
# Usada só pelo backend: autocomplete de cidade (proxy em GET /geocode/autocomplete,
# consumido por form-viagem.html/chat-viagem.html) e busca de locais reais ao
# gerar um roteiro com IA. Crie/copie em https://myprojects.geoapify.com
GEOAPIFY_API_KEY=

# ── OpenWeatherMap — previsão do tempo para personalizar o roteiro com IA ────
# Opcional: sem a key, o roteiro é gerado normalmente, só sem considerar clima.
# Crie conta grátis em https://openweathermap.org/api (plano "5 day / 3 hour forecast")
OPENWEATHER_API_KEY=

# ── CORS — origens permitidas ─────────────────────────────────────────────────
# Separe múltiplas origens por vírgula
# Em desenvolvimento: http://localhost:8000
# Com Flutter Docker (porta 7777): http://localhost:8000,http://localhost:7777
# Em produção: https://seudominio.com
ALLOWED_ORIGINS=http://localhost:8000

# ── Cloudinary — armazenamento de imagens na nuvem ───────────────────────────
# Crie conta grátis em https://cloudinary.com e copie as credenciais do dashboard
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Ambiente ──────────────────────────────────────────────────────────────────
# "development" ou "production"
# Em produção: Redis obrigatório (sem fallback em memória com múltiplos workers)
ENVIRONMENT=development

# ── MySQL (apenas para docker-compose.yml) ────────────────────────────────────
# Estas variáveis são usadas pelo container MySQL, não pela aplicação Python.
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=

# ── Portas expostas no host (docker-compose.yml) ──────────────────────────────
BACKEND_PORT=8000
# MYSQL_HOST_PORT: porta do host mapeada para 3306 do container.
# Use 3307 se a porta 3306 já estiver ocupada por MySQL local (mysqld.exe).
MYSQL_HOST_PORT=3307
REDIS_PORT=6379

# ── Uvicorn (produção) ────────────────────────────────────────────────────────
# Número de workers em produção. Em desenvolvimento, ignorado (usa --reload).
# Regra geral: (2 × núcleos de CPU) + 1
UVICORN_WORKERS=2
